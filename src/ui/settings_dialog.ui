           </item>
           <item>
            <widget class="QLabel" name="criteria_text">
             <property name="textFormat"><enum>Qt::TextFormat::RichText</enum></property>
             <property name="text"><string>&lt;html&gt;&lt;body&gt;&lt;p style="margin:0 0 10px 0;"&gt;• Working allowable: 2/3 × material yield × temperature derating factor.&lt;/p&gt;&lt;p style="margin:0 0 10px 0;"&gt;• Test allowable: 0.9 × material yield.&lt;/p&gt;&lt;p style="margin:0 0 10px 0;"&gt;• Shear allowable: 0.6 × the corresponding stress allowable.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string></property>
             <property name="wordWrap"><bool>true</bool></property>
